<!--
  Фрагмент для вставки внутрь <application> сгенерированного Tauri
  Android-проекта (src-tauri/gen/android/app/src/main/AndroidManifest.xml
  после `tauri android init`) — см. src-android/README.md.
-->

<!--
  android:exported="true" здесь ОБЯЗАТЕЛЕН (не нарушение принципа минимума
  привилегий) — систему, а не произвольное приложение, должна быть способна
  забиндиться к сервису; это и обеспечивает permission ниже:
  BIND_AUTOFILL_SERVICE — служебное разрешение уровня подписи платформы,
  которое есть только у самой системы Android. Сторонние приложения не могут
  его получить, значит exported=true тут безопасен по конструкции.
-->
<service
    android:name="com.trader.passman.autofill.PassmanAutofillService"
    android:exported="true"
    android:permission="android.permission.BIND_AUTOFILL_SERVICE"
    android:label="Passman">
    <intent-filter>
        <action android:name="android.service.autofill.AutofillService" />
    </intent-filter>
    <meta-data
        android:name="android.autofill"
        android:resource="@xml/autofill_service_descriptor" />
</service>

<!--
  exported="false" — эту Activity должен запускать только сам Android
  Autofill Framework через IntentSender, выданный нашим же сервисом, а не
  произвольное внешнее приложение напрямую через ACTION/intent-filter
  (которых здесь и нет).
-->
<activity
    android:name="com.trader.passman.autofill.UnlockActivity"
    android:exported="false"
    android:theme="@android:style/Theme.DeviceDefault.Light.Dialog.NoActionBar"
    android:excludeFromRecents="true"
    android:launchMode="singleInstance" />
