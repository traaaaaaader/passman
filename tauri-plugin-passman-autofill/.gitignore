# Generated by Cargo — скомпилированные файлы и исполняемые файлы.
/target/

# Generated by Gradle при сборке android-библиотеки плагина.
/android/build/
/android/.gradle/

# Копия Android-рантайма Tauri (`app.tauri`), которую `build.rs`
# автоматически копирует из крейта `tauri` в этот каталог при каждой
# сборке под Android — пересоздаётся всегда, коммитить незачем.
/android/.tauri/
