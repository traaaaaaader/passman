# Generated by Cargo
# will have compiled files and executables
/target/

# Generated by Tauri: схемы capabilities, Android-проект (gen/android) и
# iOS-проект (gen/apple). Всё это пересоздаётся командами `tauri android
# init` / `tauri ios init` (см. .github/workflows/build.yml) — коммитить
# незачем.
/gen/

# Android: путь к локальному SDK конкретной машины и материал для подписи
# релизных сборок — никогда не коммитим.
local.properties
*.keystore
*.jks
keystore.properties

# iOS/macOS: сертификаты и provisioning-профили для подписи — тоже никогда
# не коммитим, даже если лежат прямо в src-tauri.
*.p12
*.mobileprovision
*.cer
